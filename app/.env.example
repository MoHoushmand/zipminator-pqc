# Zipminator Flutter app, environment template
# Copy to .env and fill values. Never commit .env.

# Supabase (REQUIRED for OAuth + email auth on mobile)
# Project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API base (FastAPI backend)
NEXT_PUBLIC_API_BASE_URL=

# Sentry (optional, error reporting)
SENTRY_DSN=

# Apple Sign-In is configured natively via app/ios/Runner/Runner.entitlements
# (Sign in with Apple capability) and the bundle ID com.qdaria.zipminator.
# No env var required; needs paid Apple Developer Program for production builds.

# OAuth callback scheme (matches supabase_service.dart line 19)
# Set in app/ios/Runner/Info.plist CFBundleURLSchemes and
# app/android/app/src/main/AndroidManifest.xml intent-filter:
#   com.qdaria.zipminator://login-callback
