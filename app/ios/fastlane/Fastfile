default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight using App Store Connect API key"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    build_number = ENV["BUILD_NUMBER"] || latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.qdaria.zipminator"
    ).to_i.+(1).to_s

    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: build_number
    )

    sh("cd ../.. && flutter build ios --release --no-codesign")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "5EK49H64WB",
        uploadSymbols: true
      },
      output_directory: "build",
      output_name: "Runner.ipa",
      clean: true,
      silent: false,
      include_bitcode: false,
      include_symbols: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.qdaria.zipminator",
      ipa: "build/Runner.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: ENV["CHANGELOG"] || "Zipminator build #{build_number}. See GitHub release notes."
    )
  end

  desc "Verify fastlane config without uploading"
  lane :verify do
    UI.message("Fastlane + App Store Connect API key wiring OK")
  end
end
