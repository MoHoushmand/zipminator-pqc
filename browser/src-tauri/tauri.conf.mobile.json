{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Zipminator",
  "version": "0.2.0",
  "identifier": "com.qdaria.zipminator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1
    },
    "iOS": {
      "bundleVersion": "1",
      "minimumSystemVersion": "14.0"
    },
    "category": "DeveloperTool",
    "shortDescription": "Quantum-secure encryption on mobile",
    "longDescription": "Zipminator-PQC mobile target: NIST FIPS 203 ML-KEM-768 post-quantum key encapsulation, IBM quantum entropy pool, PQC proxy for WebView traffic."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
