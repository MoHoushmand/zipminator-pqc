# =============================================================================
# Zipminator web app, environment template
# Copy to .env.local and fill values. Never commit .env.local.
# Production values live in Vercel; mirror with `vercel env add <NAME> production`.
# =============================================================================

# -----------------------------------------------------------------------------
# next-auth v5 (REQUIRED for OAuth login on /auth/login)
# Generate AUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3099
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# LinkedIn OAuth (https://www.linkedin.com/developers/apps)
# Authorized redirect URL: ${AUTH_URL}/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Supabase (Flutter mobile + universal auth backbone via @qdaria/auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (video + text generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-high
VEO_MODEL=

# Video generation defaults
VIDEO_QUALITY=4K
VIDEO_FPS=60
VIDEO_MODEL=gemini-3.0-high

# Google Analytics (GA4)
NEXT_PUBLIC_GA_ID=

# Canonical site URL
WEB_URL=http://localhost:3099

# Universal auth (Supabase)
# Leave AUTH_COOKIE_DOMAIN blank for local dev; set to .qdaria.com in production
# so the session cookie is shared between www.qdaria.com and zipminator surfaces.
AUTH_COOKIE_DOMAIN=

# Apple Sign-In requires a paid Apple Developer account ($99/yr).
# Keep AUTH_APPLE_ENABLED=false until the Services ID + key pair is provisioned.
AUTH_APPLE_ENABLED=false
# AUTH_APPLE_SERVICES_ID=
# AUTH_APPLE_TEAM_ID=
# AUTH_APPLE_KEY_ID=
# AUTH_APPLE_PRIVATE_KEY=

# Marathon orchestrator target (prod URL for verification phases)
MARATHON_TARGET_URL=https://zipminator-pqc.vercel.app
